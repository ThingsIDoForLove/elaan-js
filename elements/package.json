{
  "name": "@elaanio/elements",
  "version": "0.2.0",
  "description": "Framework-agnostic Web Components for Elaan: <elaan-bell>, <elaan-feed>, <elaan-preferences>. Works in any page or framework.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/elaan-elements.global.js",
  "jsdelivr": "./dist/elaan-elements.global.js",
  "sideEffects": ["./dist/elaan-elements.global.js"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./global": "./dist/elaan-elements.global.js",
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elaanio/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "elaan",
    "notifications",
    "inbox",
    "web-components",
    "custom-elements",
    "push"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThingsIDoForLove/elaan-js.git",
    "directory": "elements"
  },
  "homepage": "https://github.com/ThingsIDoForLove/elaan-js/tree/main/elements#readme",
  "bugs": "https://github.com/ThingsIDoForLove/elaan-js/issues"
}
