{
  "name": "@elaan/core",
  "version": "0.1.0",
  "description": "Framework-agnostic core for Elaan: API client, observable inbox/preferences stores, and realtime transport. The base every framework SDK builds on.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "keywords": ["elaan", "notifications", "sdk", "core"],
  "license": "MIT"
}
