{
  "name": "@elaanio/core",
  "version": "0.4.0",
  "description": "Framework-agnostic core for Elaan: API client, observable inbox/preferences stores, and realtime transport. The base every framework SDK builds on.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./web-push": {
      "types": "./dist/web-push.d.ts",
      "import": "./dist/web-push.js",
      "require": "./dist/web-push.cjs"
    },
    "./service-worker": {
      "types": "./dist/service-worker.d.ts",
      "import": "./dist/service-worker.js",
      "require": "./dist/service-worker.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^3.0.0"
  },
  "keywords": ["elaan", "notifications", "sdk", "core"],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThingsIDoForLove/elaan-js.git",
    "directory": "core"
  },
  "homepage": "https://elaan.io/docs/headless.html",
  "bugs": "https://github.com/ThingsIDoForLove/elaan-js/issues"
}
