{
  "name": "@elaanio/react-native",
  "version": "0.4.1",
  "description": "React Native components + hooks for Elaan: notification inbox, preferences, and push device-token registration.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elaanio/core": "workspace:*",
    "@elaanio/react-core": "workspace:*",
    "react-native-sse": "^1.2.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.71"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "react-native": "^0.76.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "elaan",
    "notifications",
    "inbox",
    "react-native",
    "push"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThingsIDoForLove/elaan-js.git",
    "directory": "react-native"
  },
  "homepage": "https://elaan.io/docs/react-native.html",
  "bugs": "https://github.com/ThingsIDoForLove/elaan-js/issues"
}
