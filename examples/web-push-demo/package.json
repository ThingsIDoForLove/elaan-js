{
  "name": "@elaanio/example-web-push",
  "version": "0.0.0",
  "private": true,
  "description": "Runnable browser-push demo: subscribe, receive, unsubscribe. Not published.",
  "type": "module",
  "scripts": {
    "build:sw": "tsup --config tsup.sw.config.ts",
    "dev": "pnpm build:sw && vite",
    "build": "pnpm build:sw && tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json"
  },
  "dependencies": {
    "@elaanio/core": "workspace:*",
    "@elaanio/react": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vite": "^7.0.0"
  }
}
