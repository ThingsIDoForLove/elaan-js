# Copy to .env.local. Not committed.
#
# Note: NOT `VITE_`-prefixed. A VITE_ variable is inlined into the client bundle,
# and the key below must not be. vite.config.ts reads these in the dev server and
# passes only the non-secret ones through to the app.

# The API, including the version prefix.
ELAAN_API_BASE=http://localhost:8000/v1

# A tenant API key. Used only by the dev server's /elaan-token proxy, which stands
# in for your backend — the browser never sees it. Still: it can read and write
# every contact in the account, so use a throwaway account against a local API.
ELAAN_TENANT_KEY=

# Which contact to act as — its external_id in your own system. It must already
# exist (contact creation is tenant-only, so the demo can't create it for you).
ELAAN_CONTACT_EXTERNAL_ID=demo-contact
